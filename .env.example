# Diagnostic Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — diagnostic service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_diagnostic

# Content Service — HTTP API (no direct DB access to content-db)
CONTENT_SERVICE_URL=http://content-service:8004

# Auth Service — for invite callbacks
AUTH_SERVICE_URL=http://auth-service:8000
# Must match auth-service. Generate a long random value for every environment.
INTERNAL_SERVICE_TOKEN=

# Redis — CAT session state (2h TTL, JSON serialised)
REDIS_URL=redis://localhost:6379

# Gemini AI — answer evaluation + narrative report
GEMINI_API_KEY=
GEMINI_MODEL_EVAL=gemini-2.0-flash
GEMINI_MODEL_REPORT=gemini-2.0-flash

# Optional primary report model.  Leave both blank to use Gemini only.
AZURE_DEEPSEEK_API_KEY=
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_MODEL=deepseek-v4-flash

# CAT algorithm parameters
WARMUP_ITEMS=5
MIN_ITEMS=12
MAX_ITEMS=42
SE_THRESHOLD=0.30
MIN_SECTION_COVERAGE=5
DEEP_SCAN_IMPORTANCE_THRESHOLD=8
DEEP_SCAN_MAX_ITEMS=6
DEEP_SCAN_SESSION_BUDGET=6
# Deep Scan variants (DIAG-1); the values below are the defaults = variant OC15 (approved 2026-10-12,
# tools/sim_results/rootcause_stage2_summary.txt).  Pre-OC15 behaviour: offset 0.0 and confirm probes 1.
# Probe items target theta - offset (1.5 = easier probes; 0 = theta):
DEEP_SCAN_PROBE_DIFFICULTY_OFFSET=1.5
# Wrong answers on different items needed to call a probed skill a gap:
DEEP_SCAN_CONFIRM_PROBES=2
# importance | hard_prereq (failed L3 has a hard prerequisite edge):
DEEP_SCAN_TRIGGER_MODE=importance
MASTERY_THRESHOLD=0.60

# CORS
CORS_ORIGINS=["http://localhost:3000"]
