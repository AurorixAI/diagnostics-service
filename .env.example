APP_ENV=development
DEBUG=true
# standalone=true  → own Postgres, seeds knowledge tables automatically
# standalone=false → connects to monolith DB, skips knowledge table migrations
STANDALONE=true
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_v1
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=your-gemini-api-key-here
CORS_ORIGINS=["http://localhost:3000"]
WARMUP_ITEMS=3
MAX_ITEMS=25
SE_THRESHOLD=0.30
DEEP_SCAN_IMPORTANCE_THRESHOLD=8
DEEP_SCAN_MAX_ITEMS=6
